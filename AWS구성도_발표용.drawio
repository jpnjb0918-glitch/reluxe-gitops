          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s178" value="감지 (풀)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8C4FFF;strokeWidth=3;endArrow=block;fontSize=11;fontColor=#8C4FFF;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s169" target="s171">
          <mxGeometry relative="1" as="geometry" />
