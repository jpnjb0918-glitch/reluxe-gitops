        <mxCell id="s106" value="퍼블릭 서브넷 &amp;nbsp; 10.0.0~2.0/24 &amp;nbsp;&lt;span style=&#x27;font-weight:normal&#x27;&gt;— 공인 IP가 있는 유일한 계층&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFCF5;strokeColor=#B45309;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
