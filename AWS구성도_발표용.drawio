        <mxCell id="s148" value="엔드포인트 이름 유지 → 앱은 재연결만 · 전환 60~120초 · &lt;b&gt;읽기 복제본은 살아있어 조회 무중단&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#C7131F;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#232F3E;" vertex="1" parent="1">
