        <mxCell id="s147" value="&lt;b&gt;동기 스탠바이가 &lt;b&gt;자동 승격&lt;/b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#C7131F;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
