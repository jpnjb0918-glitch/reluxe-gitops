        <mxCell id="s156" value="maxUnavailable 0 — 새 파드 Ready 후 교체 · Argo CD 가 git 상태로 되돌림" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#B45309;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="790" y="547" width="740" height="64" as="geometry" />
        </mxCell>
        <mxCell id="s157" value="🔴 로컬에서 실제로 검증한 것" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#C7131F;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
