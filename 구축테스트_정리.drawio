          <mxGeometry x="40" y="360" width="1620" height="190" as="geometry" />
        </mxCell>
        <mxCell id="n181" value="&lt;b&gt;이미지 저장소&lt;/b&gt; &amp;nbsp;&lt;span style=&#x27;font-size:10px;color:#5A5A5A&#x27;&gt;— &quot;무엇을 실행할지&quot;&lt;/span&gt;&lt;br&gt;&lt;br&gt;로컬 &amp;nbsp; Docker Registry (registry:2, node5)&lt;br&gt;AWS &amp;nbsp;&amp;nbsp; ECR &amp;nbsp;&lt;span style=&#x27;font-size:10px&#x27;&gt;같은 리전 pull 무료&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;reverdi-backend 564MB · reverdi-crawler 2.7GB&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#D05C17;fontSize=11;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="80" y="410" width="740" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n182" value="&lt;b&gt;reverdi&lt;/b&gt; (git) &amp;nbsp;&lt;span style=&#x27;font-size:10px;color:#5A5A5A&#x27;&gt;— &quot;어떻게 실행할지&quot;&lt;/span&gt;&lt;br&gt;&lt;br&gt;charts/reverdi/ &amp;nbsp;&lt;span style=&#x27;font-size:10px&#x27;&gt;templates · values-vagrant · values-aws&lt;/span&gt;&lt;br&gt;infra/ &amp;nbsp; argocd/ &amp;nbsp; helm-values/&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;color:#C7131F&#x27;&gt;🔴 저장소를 둘로 나눈 이유 — 같은 곳에 두면 Jenkins 가 커밋 → 그 커밋이 Jenkins 를 다시 깨움 → &lt;b&gt;무한 루프&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8C4FFF;fontSize=11;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="850" y="410" width="780" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n183" value="③ 배포 — Argo CD (풀 방식)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8C4FFF;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="1620" height="210" as="geometry" />
        </mxCell>
        <mxCell id="n184" value="&lt;b&gt;Argo CD&lt;/b&gt; &amp;nbsp;&lt;span style=&#x27;color:#5E7F0F&#x27;&gt;✅ Synced / Healthy&lt;/span&gt;&lt;br&gt;&lt;br&gt;git ↔ 클러스터 상태를 지속 비교&lt;br&gt;&lt;br&gt;&lt;b&gt;prune: true&lt;/b&gt; &amp;nbsp;git 에서 지운 리소스는 클러스터에서도 삭제&lt;br&gt;&lt;b&gt;selfHeal: true&lt;/b&gt; &amp;nbsp;kubectl 로 손대면 &lt;b&gt;git 상태로 되돌림&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;color:#C7131F&#x27;&gt;Helm 을 helm template 으로만 쓴다 → helm rollback 불가&lt;/span&gt; &amp;nbsp;&lt;span style=&#x27;color:#5E7F0F&#x27;&gt;&lt;b&gt;롤백 = git revert&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8C4FFF;fontSize=11;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="80" y="630" width="700" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n185" value="&lt;b&gt;클러스터&lt;/b&gt;&lt;br&gt;&lt;br&gt;웹 파드 3개 (node1·2·3)&lt;br&gt;DB 3대 (primary + replica 2)&lt;br&gt;크롤러 CronJob (node4)&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#5A5A5A&#x27;&gt;파드가 레지스트리에서 이미지 pull&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7AA116;fontSize=11;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="810" y="630" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n186" value="&lt;b&gt;이렇게 나눈 이점&lt;/b&gt;&lt;br&gt;&lt;br&gt;· Jenkins 에 &lt;b&gt;클러스터 권한이 필요 없다&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;kubeconfig · EKS IAM 불필요&lt;br&gt;· git 커밋 = 배포 이력&lt;br&gt;· 지금 뭐가 떠 있는지 &lt;b&gt;git 이 증명&lt;/b&gt;&lt;br&gt;· 손으로 바꿔도 되돌아온다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5E7F0F;fontSize=11;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontColor=#232F3E;" vertex="1" parent="1">
