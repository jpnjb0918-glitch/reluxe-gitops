        <mxCell id="s150" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;AZ 하나가 죽으면&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8C4FFF;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="70" y="445" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="s151" value="&lt;b&gt;나머지 2 AZ 로 계속&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8C4FFF;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="390" y="445" width="380" height="64" as="geometry" />
        </mxCell>
        <mxCell id="s152" value="ALB · 워커노드 · RDS 가 전부 3 AZ 에 걸쳐 있다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8C4FFF;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="790" y="445" width="740" height="64" as="geometry" />
        </mxCell>
        <mxCell id="s153" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFCF5;strokeColor=#B45309;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="50" y="533" width="1500" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s154" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;배포가 잘못되면&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#B45309;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="70" y="547" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="s155" value="&lt;b&gt;롤링 업데이트 중단 · &lt;b&gt;git revert&lt;/b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#B45309;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="390" y="547" width="380" height="64" as="geometry" />
