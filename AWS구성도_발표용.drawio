        <mxCell id="s107" value="&lt;b&gt;ALB&lt;/b&gt; &amp;nbsp; 인터넷 경계 · 3 AZ&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Ingress 리소스가 자동 생성 · 대상 타입 ip&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#B45309;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="290" y="190" width="500" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s108" value="&lt;b&gt;NAT Gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;파드 아웃바운드 (크롤링)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#B45309;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="810" y="190" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s109" value="프라이빗 앱 서브넷 &amp;nbsp; 10.0.10~12.0/24 &amp;nbsp;&lt;span style=&#x27;font-weight:normal&#x27;&gt;— EKS 워커 노드&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6FBF0;strokeColor=#5E7F0F;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="270" y="275" width="860" height="210" as="geometry" />
        </mxCell>
        <mxCell id="s110" value="&lt;b&gt;reverdi-web 노드그룹&lt;/b&gt; &amp;nbsp; t3.medium × 3&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;FastAPI 파드 3개 — AZ당 하나씩 분산&lt;br&gt;topologySpread + PDB + HPA(3~6)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#5E7F0F;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="290" y="315" width="500" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s111" value="&lt;b&gt;reverdi-batch&lt;/b&gt; × 1&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;크롤러 CronJob&lt;br&gt;taint 로 격리&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#B45309;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="810" y="315" width="300" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s112" value="&lt;b&gt;왜 nginx 를 뺐나&lt;/b&gt; &amp;nbsp; 보안헤더 → ALB/앱 · 정적파일 → StaticFiles · TLS → ACM&lt;br&gt;&lt;span style=&#x27;color:#5E7F0F&#x27;&gt;이미지 3종 → 2종. 빌드·배포 대상이 줄고 관리 지점도 줄었다&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5E7F0F;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="290" y="405" width="820" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s113" value="DB 서브넷 &amp;nbsp; 10.0.20~22.0/24 &amp;nbsp;&lt;span style=&#x27;font-weight:normal&#x27;&gt;— RDS는 쿠버네티스 밖&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#C7131F;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="270" y="505" width="860" height="235" as="geometry" />
        </mxCell>
        <mxCell id="s114" value="&lt;b&gt;동기 스탠바이&lt;/b&gt; · AZ-c&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;고가용성 — 읽기 불가&lt;br&gt;RPO 0 · 자동 승격&lt;br&gt;전환 60~120초&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#C7131F;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="290" y="545" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s115" value="&lt;b&gt;주 (writer)&lt;/b&gt; · AZ-a&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;db.t4g.small · gp3&lt;br&gt;자동백업 7일 · PITR&lt;br&gt;&lt;b&gt;…-primary&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#C7131F;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="570" y="545" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s116" value="&lt;b&gt;읽기 복제본&lt;/b&gt; · AZ-b&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;조회 오프로딩 · 비동기&lt;br&gt;&lt;b&gt;…-ro&lt;/b&gt;&lt;br&gt;전환 중에도 살아있다&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#C7131F;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="850" y="545" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s117" value="&lt;b&gt;읽기/쓰기 분리&lt;/b&gt; &amp;nbsp; 앱이 &lt;b&gt;DATABASE_URL&lt;/b&gt;(쓰기) 과 &lt;b&gt;DATABASE_RO_URL&lt;/b&gt;(읽기) 을 나눠 쓴다&lt;br&gt;&lt;span style=&#x27;color:#5E7F0F&#x27;&gt;→ 주 DB 가 전환되는 동안에도 &lt;b&gt;조회는 끊기지 않는다&lt;/b&gt; (로컬 검증 완료 — 페일오버 중 응답 200 유지)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#C7131F;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="290" y="650" width="820" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s118" value="AWS 관리형 서비스 &amp;nbsp;&lt;span style=&#x27;font-weight:normal&#x27;&gt;(VPC 밖)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8C4FFF;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
