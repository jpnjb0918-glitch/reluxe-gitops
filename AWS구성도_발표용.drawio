        <mxCell id="s158" value="&lt;span style=&#x27;font-family:monospace;font-size:12px&#x27;&gt;09:37:40  200&lt;br&gt;09:37:41  200 &amp;nbsp;&amp;nbsp;← primary 파드 삭제&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;...&lt;br&gt;09:38:08  200 &amp;nbsp;&amp;nbsp;&lt;b&gt;끊김 0회&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#C7131F;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="70" y="687" width="700" height="72" as="geometry" />
        </mxCell>
        <mxCell id="s159" value="PRIMARY 가 &lt;b&gt;자동 승격&lt;/b&gt;되는 동안 웹 응답이 한 번도 끊기지 않았다.&lt;br&gt;웹 파드는 &lt;b&gt;재시작조차 하지 않았다&lt;/b&gt; (RESTARTS 0).&lt;br&gt;&lt;span style=&#x27;color:#5E7F0F&#x27;&gt;읽기가 replica 로 가기 때문 — &lt;b&gt;RDS Multi-AZ 도 같은 동작&lt;/b&gt;이므로 이 검증이 AWS 로 이어진다&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5E7F0F;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="790" y="687" width="740" height="72" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3. CI/CD" id="sl-3">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s160" value="CI/CD — Jenkins 는 빌드만, Argo CD 가 배포" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s161" value="Jenkins 가 클러스터를 만지지 않는다 → kubeconfig · EKS 접근 IAM 이 필요 없다" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#5A5A5A;" vertex="1" parent="1">
          <mxGeometry x="50" y="72" width="1500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s162" value="① 빌드 — Jenkins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F5FF;strokeColor=#1D4ED8;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="1500" height="200" as="geometry" />
        </mxCell>
        <mxCell id="s163" value="&lt;b&gt;개발자&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#879196;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="75" y="165" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s164" value="&lt;b&gt;앱 소스 저장소&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;app · Dockerfile&lt;br&gt;Jenkinsfile&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1D4ED8;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="250" y="160" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s165" value="&lt;b&gt;Jenkins 파이프라인&lt;/b&gt; &amp;nbsp;&lt;span style=&#x27;color:#5E7F0F&#x27;&gt;✅ 동작 확인&lt;/span&gt;&lt;br&gt;&lt;b&gt;lint&lt;/b&gt; → &lt;b&gt;test&lt;/b&gt;(사이드카 Postgres) → &lt;b&gt;build&lt;/b&gt;(Buildah ×2) → &lt;b&gt;chart lint&lt;/b&gt; → &lt;b&gt;git 커밋&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1D4ED8;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="510" y="155" width="1020" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s166" value="&lt;b&gt;Buildah 를 쓰는 이유&lt;/b&gt; &amp;nbsp; 쿠버네티스는 containerd 를 쓴다 — &lt;b&gt;Docker 데몬이 없어 docker build 가 안 된다&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5A5A5A&#x27;&gt;빌드 에이전트는 파드로 뜬다. 파드 정의를 Jenkinsfile 안에 두어 Jenkins 를 다시 깔아도 그대로 동작한다&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1D4ED8;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="75" y="245" width="1455" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s167" value="② 아티팩트 — 이미지와 설정을 나눠 보관" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFCF5;strokeColor=#B45309;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="50" y="340" width="1500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="s168" value="&lt;b&gt;ECR&lt;/b&gt; &amp;nbsp;&lt;span style=&#x27;font-size:11px;color:#5A5A5A&#x27;&gt;— &quot;무엇을 실행할지&quot;&lt;/span&gt;&lt;br&gt;&lt;br&gt;reverdi-backend &amp;nbsp;·&amp;nbsp; reverdi-crawler&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;같은 리전 pull 무료 · 수명주기 정책 필수&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#B45309;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="75" y="385" width="700" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s169" value="&lt;b&gt;배포 저장소&lt;/b&gt; (git) &amp;nbsp;&lt;span style=&#x27;font-size:11px;color:#5A5A5A&#x27;&gt;— &quot;어떻게 실행할지&quot;&lt;/span&gt;&lt;br&gt;&lt;br&gt;Helm 차트 · values-aws.yaml&lt;br&gt;&lt;span style=&#x27;color:#C7131F;font-size:11px&#x27;&gt;🔴 앱 소스와 나눈 이유 — 같은 곳이면 Jenkins 가 커밋 → 그 커밋이 Jenkins 를 깨움 → &lt;b&gt;무한 루프&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8C4FFF;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="805" y="385" width="725" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s170" value="③ 배포 — Argo CD (풀 방식)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8C4FFF;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="50" y="530" width="1500" height="200" as="geometry" />
        </mxCell>
        <mxCell id="s171" value="&lt;b&gt;Argo CD&lt;/b&gt; &amp;nbsp;&lt;span style=&#x27;color:#5E7F0F&#x27;&gt;✅ 동작 확인&lt;/span&gt;&lt;br&gt;&lt;br&gt;git ↔ 클러스터 상태를 지속 비교&lt;br&gt;&lt;br&gt;&lt;b&gt;prune&lt;/b&gt; &amp;nbsp;git 에서 지운 것은 클러스터에서도 삭제&lt;br&gt;&lt;b&gt;selfHeal&lt;/b&gt; &amp;nbsp;손으로 바꿔도 &lt;b&gt;git 상태로 되돌림&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5E7F0F&#x27;&gt;롤백 = &lt;b&gt;git revert&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8C4FFF;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="75" y="575" width="620" height="135" as="geometry" />
        </mxCell>
        <mxCell id="s172" value="&lt;b&gt;EKS&lt;/b&gt;&lt;br&gt;&lt;br&gt;웹 파드 3개&lt;br&gt;크롤러 CronJob&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#5A5A5A&#x27;&gt;ECR 에서 이미지 pull&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#5E7F0F;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="725" y="575" width="330" height="135" as="geometry" />
        </mxCell>
        <mxCell id="s173" value="&lt;b&gt;이렇게 나눈 이점&lt;/b&gt;&lt;br&gt;&lt;br&gt;· Jenkins 에 &lt;b&gt;클러스터 권한 불필요&lt;/b&gt;&lt;br&gt;· &lt;b&gt;git 커밋 = 배포 이력&lt;/b&gt;&lt;br&gt;· 지금 뭐가 떠 있는지 git 이 증명&lt;br&gt;· 손으로 바꿔도 되돌아온다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5E7F0F;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1085" y="575" width="445" height="135" as="geometry" />
        </mxCell>
