  <diagram name="4. 모니터링" id="sl-4">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s181" value="모니터링 — CPU 가 아니라 사용자가 겪는 실패를 본다" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s182" value="수집은 클러스터 안에서, 대시보드는 클러스터 밖에서 — 클러스터가 죽어도 상황을 볼 수 있어야 한다" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#5A5A5A;" vertex="1" parent="1">
          <mxGeometry x="50" y="72" width="1500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s183" value="클러스터 안 — 수집" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6FBF0;strokeColor=#5E7F0F;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="740" height="330" as="geometry" />
        </mxCell>
        <mxCell id="s184" value="&lt;b&gt;Prometheus&lt;/b&gt; (kube-prometheus-stack)&lt;br&gt;&lt;br&gt;· node-exporter &amp;nbsp;노드 CPU · 메모리 · 디스크&lt;br&gt;· kube-state-metrics &amp;nbsp;파드 재시작 · Deployment 상태&lt;br&gt;· &lt;b&gt;ServiceMonitor → 앱 /metrics&lt;/b&gt; &amp;nbsp;&lt;span style=&#x27;color:#5E7F0F&#x27;&gt;✅ 수집 확인&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5E7F0F;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="75" y="165" width="690" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s185" value="&lt;b&gt;Alertmanager — 증상 기준 경보&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;color:#C7131F&#x27;&gt;❌ 원인 기반&lt;/span&gt; &amp;nbsp; CPU 80% · 메모리 90%&lt;br&gt;&lt;span style=&#x27;color:#5E7F0F&#x27;&gt;✅ 증상 기반&lt;/span&gt; &amp;nbsp; 요청 실패율 &amp;gt; 1% · p95 &amp;gt; 500ms&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; HPA 가 max 에 붙어 있음 · ReplicaLag 초과&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;color:#5A5A5A&#x27;&gt;CPU 가 높아도 사용자가 멀쩡하면 깨울 일이 아니다&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#C7131F;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="75" y="290" width="690" height="140" as="geometry" />
        </mxCell>
        <mxCell id="s186" value="클러스터 밖 — 관측의 독립성" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#8C4FFF;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="810" y="120" width="740" height="330" as="geometry" />
        </mxCell>
        <mxCell id="s187" value="&lt;b&gt;Grafana&lt;/b&gt; (운영 EC2 · 클러스터 밖)&lt;br&gt;&lt;br&gt;데이터소스 2개 — 클러스터 Prometheus + CloudWatch&lt;br&gt;&lt;span style=&#x27;color:#5E7F0F&#x27;&gt;&lt;b&gt;클러스터가 죽어도 CloudWatch 로 상황 파악 가능&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#5A5A5A&#x27;&gt;k6 부하 생성기도 여기서 — 안에서 걸면 자기 자원을 먹는다&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8C4FFF;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="835" y="165" width="690" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s188" value="&lt;b&gt;CloudWatch — Prometheus 가 못 보는 것&lt;/b&gt;&lt;br&gt;&lt;br&gt;· ALB 요청 수 · 5xx · 대상 응답 시간&lt;br&gt;· &lt;b&gt;RDS ReplicaLag · 페일오버 이벤트&lt;/b&gt;&lt;br&gt;· 백업 성공/실패 · SQS 큐 깊이 · DLQ 적체&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;color:#5A5A5A&#x27;&gt;자동복구는 장애를 숨긴다 — 복구했다는 사실을 알려주는 것까지가 한 세트&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1D4ED8;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="835" y="290" width="690" height="140" as="geometry" />
        </mxCell>
        <mxCell id="s189" value="SLO / 에러 버짓 — 대시보드가 있는 것과 목표를 숫자로 정한 것은 다르다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFCF5;strokeColor=#B45309;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="50" y="470" width="1500" height="145" as="geometry" />
        </mxCell>
        <mxCell id="s190" value="&lt;b&gt;SLI&lt;/b&gt; &amp;nbsp;무엇을 재나&lt;br&gt;&lt;br&gt;가용성 = 2xx / 전체&lt;br&gt;지연 = p95&lt;br&gt;정확도 = 클릭 집계 반영률" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#B45309;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="75" y="512" width="470" height="88" as="geometry" />
        </mxCell>
        <mxCell id="s191" value="&lt;b&gt;SLO&lt;/b&gt; &amp;nbsp;목표&lt;br&gt;&lt;br&gt;조회 가용성 &lt;b&gt;99.5%&lt;/b&gt;&lt;br&gt;p95 &lt;b&gt;500ms&lt;/b&gt;&lt;br&gt;클릭 반영률 &lt;b&gt;100%&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#B45309;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="565" y="512" width="470" height="88" as="geometry" />
        </mxCell>
        <mxCell id="s192" value="&lt;b&gt;에러 버짓&lt;/b&gt; &amp;nbsp;남은 여유&lt;br&gt;&lt;br&gt;SLO 대비 얼마나 남았나&lt;br&gt;&lt;b&gt;소진되면 배포를 멈춘다&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#B45309;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1055" y="512" width="470" height="88" as="geometry" />
        </mxCell>
        <mxCell id="s193" value="발표 시연 — 영상 B 에서 화면에 무엇이 보여야 하나" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F8F8;strokeColor=#879196;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="50" y="635" width="1500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s194" value="&lt;b&gt;① Grafana 서비스&lt;/b&gt; &amp;nbsp; &lt;span style=&#x27;font-size:11px&#x27;&gt;페일오버 구간에서&lt;br&gt;&lt;b&gt;쓰기 에러만 오르고 조회는 평탄&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5E7F0F;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="75" y="676" width="350" height="48" as="geometry" />
        </mxCell>
        <mxCell id="s195" value="&lt;b&gt;② Grafana 클러스터&lt;/b&gt; &amp;nbsp; &lt;span style=&#x27;font-size:11px&#x27;&gt;부하 → HPA 가&lt;br&gt;파드를 늘리는 그래프&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1D4ED8;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="441" y="676" width="350" height="48" as="geometry" />
        </mxCell>
        <mxCell id="s196" value="&lt;b&gt;③ CloudWatch RDS&lt;/b&gt; &amp;nbsp; &lt;span style=&#x27;font-size:11px&#x27;&gt;페일오버 이벤트 시각&lt;br&gt;ReplicaLag&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8C4FFF;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="807" y="676" width="350" height="48" as="geometry" />
        </mxCell>
        <mxCell id="s197" value="&lt;b&gt;④ 터미널&lt;/b&gt; &amp;nbsp; &lt;span style=&#x27;font-size:11px&#x27;&gt;kubectl get pods -o wide&lt;br&gt;요청 루프의 실패 카운터&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#879196;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1173" y="676" width="350" height="48" as="geometry" />
        </mxCell>
