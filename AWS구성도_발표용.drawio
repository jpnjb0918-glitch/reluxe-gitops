        <mxCell id="s146" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;주 DB 가 죽으면&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#C7131F;fontSize=13;align=center;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
